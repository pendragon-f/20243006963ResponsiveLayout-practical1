<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    <TextView
        android:id="@+id/text_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="Lab 1"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/box_red"
        android:layout_width="0dp"
        android:layout_height="148dp"
        android:layout_marginTop="48dp"
        android:background="#FF0000"
        app:layout_constraintEnd_toStartOf="@+id/box_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_top" />
    <TextView
        android:id="@+id/box_blue"
        android:layout_width="0dp"
        android:layout_height="148dp"
        android:background="#0000FF"
        app:layout_constraintEnd_toStartOf="@+id/box_purple"
        app:layout_constraintStart_toEndOf="@+id/box_red"
        app:layout_constraintTop_toTopOf="@+id/box_red" />